@@ -3321,0 +3332,256 @@ impl Connection {
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn send_native_host_write_failure(
+        &mut self,
+        id: i32,
+        file_num: i32,
+        error: crate::rdn_host_bridge::NativeHostWriteJobError,
+    ) {
+        let error = if matches!(
+            error,
+            crate::rdn_host_bridge::NativeHostWriteJobError::Unavailable
+        ) {
+            NATIVE_HOST_FILE_WRITE_UNAVAILABLE
+        } else {
+            NATIVE_HOST_FILE_WRITE_REJECTED
+        };
+        self.send(fs::new_error(id, error, file_num)).await;
+    }
+
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn send_native_host_write_state_failure(&mut self, id: i32, file_num: i32) {
+        let error = match crate::rdn_host_bridge::native_host_write_service_state() {
+            crate::rdn_host_bridge::NativeHostWriteServiceState::Unavailable => {
+                crate::rdn_host_bridge::NativeHostWriteJobError::Unavailable
+            }
+            _ => crate::rdn_host_bridge::NativeHostWriteJobError::InvalidBatch,
+        };
+        self.send_native_host_write_failure(id, file_num, error)
+            .await;
+    }
+
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn begin_native_host_write_job(
+        &mut self,
+        request: &FileTransferReceiveRequest,
+        overwrite_detection: bool,
+    ) -> bool {
+        use crate::rdn_host_bridge::{
+            NativeHostWriteEntry, NativeHostWriteJobAdmission, NativeHostWriteServiceState,
+        };
+
+        match crate::rdn_host_bridge::native_host_write_service_state() {
+            NativeHostWriteServiceState::NotNativeHost => return false,
+            NativeHostWriteServiceState::Unavailable => {
+                self.send_native_host_write_failure(
+                    request.id,
+                    request.file_num,
+                    crate::rdn_host_bridge::NativeHostWriteJobError::Unavailable,
+                )
+                .await;
+                return true;
+            }
+            NativeHostWriteServiceState::Available => {}
+        }
+        if self
+            .native_host_write_jobs
+            .iter()
+            .any(|job| job.id() == request.id)
+        {
+            self.send_native_host_write_failure(
+                request.id,
+                request.file_num,
+                crate::rdn_host_bridge::NativeHostWriteJobError::DuplicateJob,
+            )
+            .await;
+            return true;
+        }
+        if self.native_host_write_jobs.len() >= MAX_NATIVE_HOST_WRITE_JOBS_PER_CONNECTION {
+            self.send_native_host_write_failure(
+                request.id,
+                request.file_num,
+                crate::rdn_host_bridge::NativeHostWriteJobError::TooManyJobs,
+            )
+            .await;
+            return true;
+        }
+        if !request.files.iter().all(|entry| {
+            matches!(entry.entry_type.enum_value(), Ok(FileType::File))
+        }) {
+            self.send_native_host_write_failure(
+                request.id,
+                request.file_num,
+                crate::rdn_host_bridge::NativeHostWriteJobError::InvalidBatch,
+            )
+            .await;
+            return true;
+        }
+        let entries = request
+            .files
+            .iter()
+            .map(|entry| {
+                NativeHostWriteEntry::new(
+                    entry.name.clone(),
+                    entry.size,
+                    entry.modified_time,
+                )
+            })
+            .collect();
+        match crate::rdn_host_bridge::native_host_begin_new_file_write_job(
+            request.id,
+            &request.path,
+            request.file_num,
+            entries,
+            request.total_size,
+            overwrite_detection,
+        ) {
+            NativeHostWriteJobAdmission::Admitted(job) => {
+                self.native_host_write_jobs.push(job);
+            }
+            NativeHostWriteJobAdmission::NotNativeHost
+            | NativeHostWriteJobAdmission::Unavailable => {
+                self.send_native_host_write_failure(
+                    request.id,
+                    request.file_num,
+                    crate::rdn_host_bridge::NativeHostWriteJobError::Unavailable,
+                )
+                .await;
+            }
+            NativeHostWriteJobAdmission::Rejected(error) => {
+                self.send_native_host_write_failure(
+                    request.id,
+                    request.file_num,
+                    error,
+                )
+                .await;
+            }
+        }
+        true
+    }
+
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn write_native_host_file_block(&mut self, block: &FileTransferBlock) -> bool {
+        let Some(index) = self
+            .native_host_write_jobs
+            .iter()
+            .position(|job| job.id() == block.id)
+        else {
+            if matches!(
+                crate::rdn_host_bridge::native_host_write_service_state(),
+                crate::rdn_host_bridge::NativeHostWriteServiceState::NotNativeHost
+            ) {
+                return false;
+            }
+            self.send_native_host_write_state_failure(block.id, block.file_num)
+                .await;
+            return true;
+        };
+        let result = self.native_host_write_jobs[index].write_block(
+            block.file_num,
+            block.data.as_ref(),
+            block.compressed,
+        );
+        if let Err(error) = result {
+            self.native_host_write_jobs.remove(index);
+            self.send_native_host_write_failure(block.id, block.file_num, error)
+                .await;
+        }
+        true
+    }
+
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn confirm_native_host_new_file_digest(&mut self, digest: &FileTransferDigest) -> bool {
+        let Some(index) = self
+            .native_host_write_jobs
+            .iter()
+            .position(|job| job.id() == digest.id)
+        else {
+            if matches!(
+                crate::rdn_host_bridge::native_host_write_service_state(),
+                crate::rdn_host_bridge::NativeHostWriteServiceState::NotNativeHost
+            ) {
+                return false;
+            }
+            self.send_native_host_write_state_failure(digest.id, digest.file_num)
+                .await;
+            return true;
+        };
+        let result = self.native_host_write_jobs[index].confirm_new_file_digest(
+            digest.file_num,
+            digest.file_size,
+            digest.last_modified,
+            digest.is_resume,
+        );
+        if let Err(error) = result {
+            self.native_host_write_jobs.remove(index);
+            self.send_native_host_write_failure(digest.id, digest.file_num, error)
+                .await;
+            return true;
+        }
+        let request = FileTransferSendConfirmRequest {
+            id: digest.id,
+            file_num: digest.file_num,
+            union: Some(file_transfer_send_confirm_request::Union::OffsetBlk(0)),
+            ..Default::default()
+        };
+        self.send(fs::new_send_confirm(request)).await;
+        true
+    }
+
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn finish_native_host_write_job(&mut self, done: &FileTransferDone) -> bool {
+        let Some(index) = self
+            .native_host_write_jobs
+            .iter()
+            .position(|job| job.id() == done.id)
+        else {
+            if matches!(
+                crate::rdn_host_bridge::native_host_write_service_state(),
+                crate::rdn_host_bridge::NativeHostWriteServiceState::NotNativeHost
+            ) {
+                return false;
+            }
+            self.send_native_host_write_state_failure(done.id, done.file_num)
+                .await;
+            return true;
+        };
+        let job = self.native_host_write_jobs.remove(index);
+        match job.finish(done.file_num) {
+            Ok(()) => self.send(fs::new_done(done.id, done.file_num)).await,
+            Err(error) => {
+                self.send_native_host_write_failure(done.id, done.file_num, error)
+                    .await
+            }
+        }
+        true
+    }
+
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    fn cancel_native_host_write_job(&mut self, id: i32) -> bool {
+        if let Some(index) = self
+            .native_host_write_jobs
+            .iter()
+            .position(|job| job.id() == id)
+        {
+            self.native_host_write_jobs.remove(index);
+            return true;
+        }
+        !matches!(
+            crate::rdn_host_bridge::native_host_write_service_state(),
+            crate::rdn_host_bridge::NativeHostWriteServiceState::NotNativeHost
+        )
+    }
+
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn reject_native_host_write_error(&mut self, error: &FileTransferError) -> bool {
+        let handled = self.cancel_native_host_write_job(error.id);
+        if handled {
+            self.send_native_host_write_failure(
+                error.id,
+                error.file_num,
+                crate::rdn_host_bridge::NativeHostWriteJobError::InvalidBatch,
+            )
+            .await;
+        }
+        handled
+    }
+
