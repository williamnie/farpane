+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn begin_native_host_read_job(
+        &mut self,
+        request: &FileTransferSendRequest,
+        overwrite_detection: bool,
+    ) -> bool {
+        use crate::rdn_host_bridge::{NativeHostReadJobAdmission, NativeHostReadJobError};
+
+        match crate::rdn_host_bridge::native_host_begin_read_job(
+            request.id,
+            &request.path,
+            request.file_num,
+            request.include_hidden,
+            overwrite_detection,
+        ) {
+            NativeHostReadJobAdmission::NotNativeHost => false,
+            NativeHostReadJobAdmission::Admitted(job) => {
+                let duplicate = self
+                    .native_host_read_jobs
+                    .iter()
+                    .any(|active| active.id() == request.id)
+                    || self
+                        .native_host_write_jobs
+                        .iter()
+                        .any(|active| active.id() == request.id)
+                    || self.read_jobs.iter().any(|active| active.id == request.id)
+                    || self.cm_read_job_ids.contains(&request.id);
+                if duplicate {
+                    self.send_native_host_read_failure(
+                        request.id,
+                        request.file_num,
+                        NativeHostReadJobError::DuplicateJob,
+                    )
+                    .await;
+                    return true;
+                }
+                if self.native_host_read_jobs.len() >= MAX_NATIVE_HOST_READ_JOBS_PER_CONNECTION {
+                    self.send_native_host_read_failure(
+                        request.id,
+                        request.file_num,
+                        NativeHostReadJobError::TooManyJobs,
+                    )
+                    .await;
+                    return true;
+                }
+                let path = job.wire_path().to_owned();
+                let entries = native_host_read_file_entries(job.entries());
+                self.send(fs::new_dir(request.id, path.clone(), entries.clone()))
+                    .await;
+                self.post_file_audit(
+                    FileAuditType::RemoteSend,
+                    &path,
+                    Self::get_files_for_audit(fs::JobType::Generic, entries),
+                    json!({}),
+                );
+                self.native_host_read_jobs.push(job);
+                self.file_timer = crate::rustdesk_interval(time::interval(MILLI1));
+                true
+            }
+            NativeHostReadJobAdmission::Rejected(error) => {
+                self.send_native_host_read_failure(request.id, request.file_num, error)
+                    .await;
+                true
+            }
+            NativeHostReadJobAdmission::Unavailable => {
+                self.send_native_host_read_failure(
+                    request.id,
+                    request.file_num,
+                    NativeHostReadJobError::Unavailable,
+                )
+                .await;
+                true
+            }
+        }
+    }
+
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn poll_native_host_read_job(&mut self) -> bool {
+        use crate::rdn_host_bridge::NativeHostReadJobStep;
+
+        let Some(index) = self
+            .native_host_read_jobs
+            .iter()
+            .position(|job| !job.is_waiting_for_confirmation())
+        else {
+            return false;
+        };
+        let id = self.native_host_read_jobs[index].id();
+        let result = self.native_host_read_jobs[index].poll();
+        match result {
+            Ok(NativeHostReadJobStep::WaitingForConfirmation) => {}
+            Ok(NativeHostReadJobStep::Digest {
+                file_num,
+                file_size,
+                modified_time,
+            }) => {
+                let mut response = FileResponse::new();
+                response.set_digest(FileTransferDigest {
+                    id,
+                    file_num,
+                    file_size,
+                    last_modified: modified_time,
+                    is_upload: false,
+                    ..Default::default()
+                });
+                let mut message = Message::new();
+                message.set_file_response(response);
+                self.send(message).await;
+            }
+            Ok(NativeHostReadJobStep::Block {
+                file_num,
+                data,
+                compressed,
+            }) => {
+                self.send(fs::new_block(FileTransferBlock {
+                    id,
+                    file_num,
+                    data: data.into(),
+                    compressed,
+                    ..Default::default()
+                }))
+                .await;
+            }
+            Ok(NativeHostReadJobStep::Done { file_num }) => {
+                self.native_host_read_jobs.remove(index);
+                self.send(fs::new_done(id, file_num)).await;
+            }
+            Err(error) => {
+                self.native_host_read_jobs.remove(index);
+                self.send_native_host_read_failure(id, -1, error).await;
+            }
+        }
+        true
+    }
+
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn confirm_native_host_read_job(
+        &mut self,
+        request: &FileTransferSendConfirmRequest,
+    ) -> bool {
+        use crate::rdn_host_bridge::NativeHostReadJobError;
+
+        let Some(index) = self
+            .native_host_read_jobs
+            .iter()
+            .position(|job| job.id() == request.id)
+        else {
+            return false;
+        };
+        let confirmation = match native_host_read_confirmation(request) {
+            Ok(confirmation) => confirmation,
+            Err(_) => {
+                self.native_host_read_jobs.remove(index);
+                self.send_native_host_read_failure(
+                    request.id,
+                    request.file_num,
+                    NativeHostReadJobError::InvalidConfirmation,
+                )
+                .await;
+                return true;
+            }
+        };
+        if let Err(error) =
+            self.native_host_read_jobs[index].confirm(request.file_num, confirmation)
+        {
+            self.native_host_read_jobs.remove(index);
+            self.send_native_host_read_failure(request.id, request.file_num, error)
+                .await;
+        } else {
+            self.file_timer = crate::rustdesk_interval(time::interval(MILLI1));
+        }
         true
+    }
+
