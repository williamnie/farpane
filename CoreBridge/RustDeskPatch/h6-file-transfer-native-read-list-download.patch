+#[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+fn native_host_read_file_entries(
+    entries: Vec<crate::rdn_host_bridge::NativeHostReadListEntry>,
+) -> Vec<FileEntry> {
+    entries
+        .into_iter()
+        .map(|entry| FileEntry {
+            entry_type: match entry.kind() {
+                crate::rdn_host_bridge::NativeHostReadEntryKind::Directory => FileType::Dir,
+                crate::rdn_host_bridge::NativeHostReadEntryKind::File => FileType::File,
+            }
+            .into(),
+            name: entry.name().to_owned(),
+            size: entry.size(),
+            modified_time: entry.modified_time(),
+            ..Default::default()
+        })
+        .collect()
+}

 #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+fn native_host_read_confirmation(
+    request: &FileTransferSendConfirmRequest,
+) -> Result<
+    crate::rdn_host_bridge::NativeHostReadConfirmation,
+    crate::rdn_host_bridge::NativeHostReadJobError,
+> {
+    match request.union {
+        Some(file_transfer_send_confirm_request::Union::Skip(true)) => {
+            Ok(crate::rdn_host_bridge::NativeHostReadConfirmation::Skip)
+        }
+        Some(file_transfer_send_confirm_request::Union::Skip(false)) => {
+            Ok(crate::rdn_host_bridge::NativeHostReadConfirmation::ContinueAt { offset: 0 })
+        }
+        Some(file_transfer_send_confirm_request::Union::OffsetBlk(offset)) => {
+            Ok(crate::rdn_host_bridge::NativeHostReadConfirmation::ContinueAt { offset })
+        }
+        _ => Err(crate::rdn_host_bridge::NativeHostReadJobError::InvalidConfirmation),
+    }
+}
