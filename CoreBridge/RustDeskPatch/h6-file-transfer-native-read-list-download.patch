+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    async fn send_native_host_directory(&mut self, path: &str, include_hidden: bool) -> bool {
+        use crate::rdn_host_bridge::{NativeHostFileReadOutcome, NativeHostReadJobError};
+
+        match crate::rdn_host_bridge::native_host_list_directory(path, include_hidden) {
+            NativeHostFileReadOutcome::NotNativeHost => false,
+            NativeHostFileReadOutcome::Succeeded((path, entries)) => {
+                self.send(fs::new_dir(0, path, native_host_read_file_entries(entries)))
+                    .await;
+                true
+            }
+            NativeHostFileReadOutcome::Rejected(error) => {
+                self.send_native_host_read_failure(0, -1, error).await;
+                true
+            }
+            NativeHostFileReadOutcome::Unavailable => {
+                self.send_native_host_read_failure(0, -1, NativeHostReadJobError::Unavailable)
+                    .await;
+                true
+            }
+        }
+    }
