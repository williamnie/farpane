+        use crate::rdn_host_bridge::{NativeHostFileReadOutcome, NativeHostReadJobError};
+
+        match crate::rdn_host_bridge::native_host_list_empty_directories(path, include_hidden) {
+            NativeHostFileReadOutcome::NotNativeHost => false,
+            NativeHostFileReadOutcome::Succeeded((path, empty_directories)) => {
+                let mut response = FileResponse::new();
+                response.set_empty_dirs(ReadEmptyDirsResponse {
+                    path,
