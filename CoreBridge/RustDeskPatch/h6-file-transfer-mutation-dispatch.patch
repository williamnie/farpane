 const NATIVE_HOST_CONTROL_BUSY: &str = "Another remote control session is active";
+
+#[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+const NATIVE_HOST_FILE_OPERATION_REJECTED: &str = "native-file-operation-rejected";
+#[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+const NATIVE_HOST_FILE_OPERATION_UNAVAILABLE: &str = "native-file-operation-unavailable";
+
+#[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+fn native_host_file_mutation_response(
+    id: i32,
+    file_num: i32,
+    mutation: crate::rdn_host_bridge::NativeHostFileMutation<'_>,
+) -> Option<Message> {
+    use crate::rdn_host_bridge::NativeHostFileMutationOutcome;

+    match crate::rdn_host_bridge::native_host_dispatch_file_mutation(mutation) {
+        NativeHostFileMutationOutcome::NotNativeHost => None,
+        NativeHostFileMutationOutcome::Succeeded => Some(fs::new_done(id, file_num)),
+        NativeHostFileMutationOutcome::Rejected => Some(fs::new_error(
+            id,
+            NATIVE_HOST_FILE_OPERATION_REJECTED,
+            file_num,
+        )),
+        NativeHostFileMutationOutcome::Unavailable => Some(fs::new_error(
+            id,
+            NATIVE_HOST_FILE_OPERATION_UNAVAILABLE,
+            file_num,
+        )),
+    }
+}
