+mod scroll_modifier_tests {
+    use super::*;
+
+    fn event_flags(source: &CGEventSource, precise: bool, horizontal: bool, keys: &[Key]) -> u64 {
+        let event = create_scroll_event(source, 1, precise, horizontal, keys);
+        assert!(!event.is_null());
+        unsafe {
+            let flags = CGEventGetFlags(event);
+            CFRelease(event as *const c_void);
+            flags
+        }
+    }
+
+    #[test]
+    fn scroll_events_carry_command_and_clear_it_for_plain_pan() {
+        let source = CGEventSource::new(CGEventSourceStateID::CombinedSessionState).unwrap();
+        for precise in [true, false] {
+            for horizontal in [true, false] {
+                assert_eq!(
+                    event_flags(&source, precise, horizontal, &[Key::Meta]),
+                    CGEventFlags::CGEventFlagCommand.bits()
+                );
+                assert_eq!(event_flags(&source, precise, horizontal, &[]), 0);
+            }
+        }
+    }
+
+    #[test]
+    fn scroll_events_preserve_combined_and_right_hand_modifiers() {
+        let source = CGEventSource::new(CGEventSourceStateID::CombinedSessionState).unwrap();
+        let expected = CGEventFlags::CGEventFlagCommand
+            | CGEventFlags::CGEventFlagControl
+            | CGEventFlags::CGEventFlagShift
+            | CGEventFlags::CGEventFlagAlternate;
+        for keys in [
+            vec![Key::Meta, Key::Control, Key::Shift, Key::Alt],
+            vec![Key::RWin, Key::RightControl, Key::RightShift, Key::RightAlt],
+        ] {
+            assert_eq!(event_flags(&source, true, false, &keys), expected.bits());
+        }
     }
 }

