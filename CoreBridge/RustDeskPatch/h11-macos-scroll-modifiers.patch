+
+fn create_scroll_event(
+    source: &CGEventSource,
+    direction: i32,
+    is_track_pad: bool,
+    is_horizontal: bool,
+    modifiers: &[Key],
+) -> *mut MyCGEvent {
+    let units = if is_track_pad {
+        ScrollUnit::Pixel
+    } else {
+        ScrollUnit::Line
+    };
+    let flags = modifiers
+        .iter()
+        .fold(CGEventFlags::CGEventFlagNull, |flags, key| {
+            flags
+                | match key {
+                    Key::Meta | Key::RWin => CGEventFlags::CGEventFlagCommand,
+                    Key::Control | Key::RightControl => CGEventFlags::CGEventFlagControl,
+                    Key::Shift | Key::RightShift => CGEventFlags::CGEventFlagShift,
+                    Key::Alt | Key::RightAlt => CGEventFlags::CGEventFlagAlternate,
+                    Key::CapsLock => CGEventFlags::CGEventFlagAlphaShift,
+                    _ => CGEventFlags::CGEventFlagNull,
+                }
+        });
+    unsafe {
+        let event = if is_horizontal {
+            CGEventCreateScrollWheelEvent(source, units, 2, 0, direction)
+        } else {
+            CGEventCreateScrollWheelEvent(source, units, 1, direction)
+        };
+        if !event.is_null() {
+            // 每个滚动事件使用自己的修饰键，不依赖键盘模式或异步按键状态。
+            // 普通滚动也必须显式清零，避免继承上一次缩放的 Command。
+            CGEventSetFlags(event, flags.bits());
+        }
+        event
+    }
+}
