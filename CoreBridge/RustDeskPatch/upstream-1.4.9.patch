+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub(crate) enum SemanticPointerKind {
+    ScaleUpdate { ended: bool },
+    PanStart,
+    PanUpdate,
+    PanEnd,
+}
+
+#[derive(Clone)]
+pub(crate) struct NormalizedPointerInput {
+    pub(crate) event: PointerDeviceEvent,
+    pub(crate) kind: SemanticPointerKind,
+}
+
+impl NormalizedPointerInput {
+    pub(crate) const MAX_SCALE_DELTA_MILLI: i32 = 1_000;
+    pub(crate) const MAX_PAN_DELTA: i32 = 10_000;
+
+    pub(crate) fn from_wire(mut event: PointerDeviceEvent) -> Option<Self> {
+        if !input_modifiers_are_canonical(&event.modifiers) {
+            return None;
+        }
+        let touch = match event.union.as_mut()? {
+            pointer_device_event::Union::TouchEvent(touch) => touch,
+            _ => return None,
+        };
+        let kind = match touch.union.as_mut()? {
+            touch_event::Union::ScaleUpdate(scale) => {
+                scale.scale = scale
+                    .scale
+                    .clamp(-Self::MAX_SCALE_DELTA_MILLI, Self::MAX_SCALE_DELTA_MILLI);
+                SemanticPointerKind::ScaleUpdate {
+                    ended: scale.scale == 0,
+                }
+            }
+            touch_event::Union::PanStart(_) => SemanticPointerKind::PanStart,
+            touch_event::Union::PanUpdate(pan) => {
+                pan.x = pan.x.clamp(-Self::MAX_PAN_DELTA, Self::MAX_PAN_DELTA);
+                pan.y = pan.y.clamp(-Self::MAX_PAN_DELTA, Self::MAX_PAN_DELTA);
+                SemanticPointerKind::PanUpdate
+            }
+            touch_event::Union::PanEnd(_) => SemanticPointerKind::PanEnd,
+            _ => return None,
+        };
+        Some(Self { event, kind })
+    }
+}
+
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub(crate) enum SemanticKeyKind {
+    LegacyControl(ControlKey),
+    LegacyCharacter,
+    LegacyUnicode,
+    LegacySequence,
+    MappedPhysical,
+    TranslatedPhysical,
+    TranslatedSequence,
+    #[cfg(target_os = "windows")]
+    WindowsHotkey,
+}
+
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub(crate) enum SemanticKeyAction {
+    Down,
+    Up,
+    Press,
+    Text,
+}
+
+#[derive(Clone)]
+pub(crate) struct NormalizedKeyInput {
+    pub(crate) event: KeyEvent,
+    pub(crate) kind: SemanticKeyKind,
+    pub(crate) action: SemanticKeyAction,
+}
+
+impl NormalizedKeyInput {
+    pub(crate) const MAX_SEQUENCE_BYTES: usize = 4_096;
+
+    pub(crate) fn from_wire(mut event: KeyEvent) -> Option<Self> {
+        if !key_modifiers_are_canonical(&event.modifiers) {
+            return None;
+        }
+        let mode = event.mode.enum_value().ok()?;
+        let kind = match (mode, event.union.as_ref()?) {
+            (KeyboardMode::Legacy | KeyboardMode::Auto, key_event::Union::ControlKey(control)) => {
+                let control = control.enum_value().ok()?;
+                if !legacy_control_key_is_supported(control) {
+                    return None;
+                }
+                SemanticKeyKind::LegacyControl(control)
+            }
+            (KeyboardMode::Legacy | KeyboardMode::Auto, key_event::Union::Chr(value)) => {
+                char::from_u32(*value).filter(|value| *value != '\0')?;
+                SemanticKeyKind::LegacyCharacter
+            }
+            (KeyboardMode::Legacy | KeyboardMode::Auto, key_event::Union::Unicode(value)) => {
+                char::from_u32(*value).filter(|value| *value != '\0')?;
+                SemanticKeyKind::LegacyUnicode
+            }
+            (KeyboardMode::Legacy | KeyboardMode::Auto, key_event::Union::Seq(sequence)) => {
+                if !key_sequence_is_canonical(sequence) {
+                    return None;
+                }
+                SemanticKeyKind::LegacySequence
+            }
+            (KeyboardMode::Map, key_event::Union::Chr(code))
+                if position_keycode_is_canonical(*code, false) =>
+            {
+                SemanticKeyKind::MappedPhysical
+            }
+            (KeyboardMode::Translate, key_event::Union::Chr(code))
+                if position_keycode_is_canonical(*code, true) =>
+            {
+                SemanticKeyKind::TranslatedPhysical
+            }
+            (KeyboardMode::Translate, key_event::Union::Seq(sequence)) => {
+                if !key_sequence_is_canonical(sequence) {
+                    return None;
+                }
+                SemanticKeyKind::TranslatedSequence
+            }
+            #[cfg(target_os = "windows")]
+            (KeyboardMode::Translate, key_event::Union::Win2winHotkey(_)) => {
+                SemanticKeyKind::WindowsHotkey
+            }
+            _ => return None,
+        };
+
+        let action = if matches!(
+            kind,
+            SemanticKeyKind::LegacyUnicode
+                | SemanticKeyKind::LegacySequence
+                | SemanticKeyKind::TranslatedSequence
+        ) {
+            event.down = false;
+            event.press = false;
+            SemanticKeyAction::Text
+        } else if event.press {
+            if event.down {
+                return None;
+            }
+            SemanticKeyAction::Press
+        } else if event.down {
+            SemanticKeyAction::Down
+        } else {
+            SemanticKeyAction::Up
+        };
+
+        if matches!(
+            kind,
+            SemanticKeyKind::LegacyControl(ControlKey::CtrlAltDel | ControlKey::LockScreen)
+        ) && (action != SemanticKeyAction::Down || !event.modifiers.is_empty())
+        {
+            return None;
+        }
+
+        Some(Self {
+            event,
+            kind,
+            action,
+        })
+    }
+
+    pub(crate) fn is_enter(&self) -> bool {
+        matches!(
+            self.kind,
+            SemanticKeyKind::LegacyControl(ControlKey::Return | ControlKey::NumpadEnter)
+        )
+    }
+
+    pub(crate) fn is_modifier(&self) -> bool {
+        matches!(
+            self.kind,
+            SemanticKeyKind::LegacyControl(
+                ControlKey::Alt
+                    | ControlKey::Control
+                    | ControlKey::Meta
+                    | ControlKey::RAlt
+                    | ControlKey::RControl
+                    | ControlKey::RShift
+                    | ControlKey::RWin
+                    | ControlKey::Shift
+            )
+        )
+    }
+
+    pub(crate) fn physical_modifier(&self) -> Option<rdev::Key> {
+        if !matches!(
+            self.kind,
+            SemanticKeyKind::MappedPhysical | SemanticKeyKind::TranslatedPhysical
+        ) {
+            return None;
+        }
+        let code = if self.kind == SemanticKeyKind::TranslatedPhysical {
+            self.event.chr() & 0x0000_FFFF
+        } else {
+            self.event.chr()
+        };
+        let key = crate::keyboard::keycode_to_rdev_key(code);
+        crate::keyboard::is_modifier(&key).then_some(key)
+    }
+
+    pub(crate) fn promote_to_press(&mut self) {
+        self.action = SemanticKeyAction::Press;
+        self.event.down = false;
+        self.event.press = true;
+    }
+}
+
+fn key_sequence_is_canonical(sequence: &str) -> bool {
+    !sequence.is_empty()
+        && sequence.len() <= NormalizedKeyInput::MAX_SEQUENCE_BYTES
+        && !sequence.contains('\0')
+}
+
+fn legacy_control_key_is_supported(control: ControlKey) -> bool {
+    matches!(control, ControlKey::CtrlAltDel | ControlKey::LockScreen)
+        || KEY_MAP.contains_key(&control.value())
+}
+
+fn position_keycode_is_canonical(code: u32, translated: bool) -> bool {
+    #[cfg(target_os = "macos")]
+    {
+        let _ = translated;
+        return code <= 0x7f;
+    }
+    #[cfg(target_os = "windows")]
+    {
+        return if translated {
+            code >> 16 <= 0xff
+        } else {
+            code <= u16::MAX as u32
+        };
+    }
+    #[cfg(not(any(target_os = "macos", target_os = "windows")))]
+    {
+        let _ = translated;
+        code <= u16::MAX as u32
+    }
+}
+
+fn key_modifiers_are_canonical(modifiers: &[EnumOrUnknown<ControlKey>]) -> bool {
+    let mut seen = 0_u16;
+    for modifier in modifiers {
+        let bit = match modifier.value() {
+            value
+                if value == ControlKey::Alt.value()
+                    || value == ControlKey::Option.value()
+                    || value == ControlKey::Menu.value() =>
+            {
+                1 << 0
+            }
+            value if value == ControlKey::Control.value() => 1 << 1,
+            value if value == ControlKey::Shift.value() => 1 << 2,
+            value if value == ControlKey::Meta.value() => 1 << 3,
+            value if value == ControlKey::RAlt.value() => 1 << 4,
+            value if value == ControlKey::RControl.value() => 1 << 5,
+            value if value == ControlKey::RShift.value() => 1 << 6,
+            value if value == ControlKey::RWin.value() => 1 << 7,
+            value if value == ControlKey::CapsLock.value() => 1 << 8,
+            value if value == ControlKey::NumLock.value() => 1 << 9,
+            _ => return false,
+        };
+        if seen & bit != 0 {
+            return false;
+        }
+        seen |= bit;
+    }
+    true
+}
+
+fn input_modifiers_are_canonical(modifiers: &[EnumOrUnknown<ControlKey>]) -> bool {
+    let mut seen = 0_u8;
+    for modifier in modifiers {
+        let bit = match modifier.value() {
+            value if value == ControlKey::Alt.value() => 1 << 0,
+            value if value == ControlKey::Control.value() => 1 << 1,
+            value if value == ControlKey::Shift.value() => 1 << 2,
+            value if value == ControlKey::Meta.value() => 1 << 3,
+            _ => return false,
+        };
+        if seen & bit != 0 {
+            return false;
+        }
+        seen |= bit;
+    }
+    true
+}
+
+#[inline]
+fn input_adapter_gate_allows(gate: Option<InputAdapterGate>) -> bool {
+    gate.map(|gate| gate()).unwrap_or(true)
+}
+
+pub(crate) fn native_host_accessibility_permission_enabled(
+    configured: bool,
+    native_host_active: bool,
+    accessibility_trusted: bool,
+) -> bool {
+    configured && (!native_host_active || accessibility_trusted)
+}
+
+#[inline]
+pub(crate) fn native_host_platform_input_permission_allows(configured: bool) -> bool {
+    if !configured {
+        return false;
+    }
+    #[cfg(all(feature = "rdn-native-host", target_os = "macos"))]
+    {
+        let native_host_active = crate::rdn_host_bridge::native_host_instance_is_live();
+        if !native_host_active {
+            return true;
+        }
+        return native_host_accessibility_permission_enabled(
+            crate::platform::macos::is_active_aqua_session(),
+            native_host_active,
+            crate::platform::macos::is_process_trusted(false),
+        );
+    }
+    #[cfg(not(all(feature = "rdn-native-host", target_os = "macos")))]
+    {
+        true
+    }
+}
