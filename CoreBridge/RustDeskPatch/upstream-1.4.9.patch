+        assert!(current_gate());
+
+        let stale_gate = input_adapter_gate(
+            authorization,
+            Some(first),
+            permission.clone(),
+            mapping.clone(),
+        );
+        mapping.advance();
+        assert!(!stale_gate());
+
+        let second = mapping.snapshot().expect("advanced mapping stays valid");
+        assert_ne!(first, second);
+        let current_gate = input_adapter_gate(
+            authorization,
+            Some(second),
+            permission.clone(),
+            mapping.clone(),
+        );
+        assert!(current_gate());
+        let stale_second_gate = input_adapter_gate(
+            authorization,
+            Some(second),
+            permission.clone(),
+            mapping.clone(),
+        );
+        mapping.advance();
+        assert!(!stale_second_gate());
+
+        let saturated = InputMappingEpoch {
+            state: AtomicU64::new(u64::MAX),
+        };
+        let last = saturated
+            .snapshot()
+            .expect("last mapping is initially valid");
+        saturated.advance();
+        assert!(saturated.snapshot().is_none());
+        assert!(!saturated.accepts(last));
