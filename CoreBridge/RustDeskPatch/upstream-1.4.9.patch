+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+#[derive(Debug)]
+struct InputMappingEpoch {
+    // Zero is permanently invalid. Reaching u64::MAX fails closed instead of
+    // wrapping and making an old display mapping generation valid again.
+    state: AtomicU64,
+}
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+impl InputMappingEpoch {
+    fn new() -> Self {
+        Self {
+            state: AtomicU64::new(1),
+        }
+    }
+
+    fn advance(&self) {
+        let mut current = self.state.load(Ordering::Acquire);
+        loop {
+            if current == 0 {
+                return;
+            }
+            let next = current.checked_add(1).unwrap_or(0);
+            match self.state.compare_exchange_weak(
+                current,
+                next,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            ) {
+                Ok(_) => return,
+                Err(actual) => current = actual,
+            }
+        }
+    }
+
+    fn snapshot(&self) -> Option<InputMappingSnapshot> {
+        let state = self.state.load(Ordering::Acquire);
+        (state != 0).then_some(InputMappingSnapshot(state))
+    }
+
+    fn accepts(&self, snapshot: InputMappingSnapshot) -> bool {
+        snapshot.0 != 0 && self.state.load(Ordering::Acquire) == snapshot.0
+    }
+}
