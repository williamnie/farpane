+pub(crate) fn route_transport_snapshot(connection_ids: &HashSet<i32>) -> RouteTransportSnapshot {
+    let transports = CONNECTION_TRANSPORTS.lock().unwrap();
+    let mut snapshot = RouteTransportSnapshot {
+        subscriber_count: connection_ids.len(),
+        ..Default::default()
+    };
+    for connection_id in connection_ids {
+        match transports.get(connection_id) {
+            Some(ConnectionTransport::Direct) => snapshot.direct_subscribers += 1,
+            Some(ConnectionTransport::Relay) => snapshot.relay_subscribers += 1,
+            None => snapshot.unknown_subscribers += 1,
+        }
+    }
+    snapshot
+}
