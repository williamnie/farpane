+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub(crate) enum SemanticMouseButton {
+    Left,
+    Right,
+    Middle,
+    Back,
+    Forward,
+}
+
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub(crate) enum SemanticMouseKind {
+    AbsoluteMove,
+    RelativeMove,
+    ButtonDown(SemanticMouseButton),
+    ButtonUp(SemanticMouseButton),
+    DiscreteScroll,
+    PreciseScroll,
+}
+
+#[derive(Clone)]
+pub(crate) struct NormalizedMouseInput {
+    pub(crate) event: MouseEvent,
+    pub(crate) kind: SemanticMouseKind,
+}
+
+impl NormalizedMouseInput {
+    pub(crate) const MAX_RELATIVE_DELTA: i32 = 10_000;
+    pub(crate) const MAX_SCROLL_DELTA: i32 = 120;
+    const VALID_HELD_BUTTONS: i32 = MOUSE_BUTTON_LEFT
+        | MOUSE_BUTTON_RIGHT
+        | MOUSE_BUTTON_WHEEL
+        | MOUSE_BUTTON_BACK
+        | MOUSE_BUTTON_FORWARD;
+
+    pub(crate) fn from_wire(mut event: MouseEvent) -> Option<Self> {
+        if !input_modifiers_are_canonical(&event.modifiers) {
+            return None;
+        }
+
+        let event_type = event.mask & MOUSE_TYPE_MASK;
+        let buttons = event.mask >> 3;
+        let kind = match event_type {
+            // Absolute move carries the controller's currently held buttons
+            // during a drag. The adapter does not re-press them, but the mask
+            // must survive typed normalization for upstream compatibility.
+            MOUSE_TYPE_MOVE if buttons & !Self::VALID_HELD_BUTTONS == 0 => {
+                SemanticMouseKind::AbsoluteMove
+            }
+            MOUSE_TYPE_MOVE_RELATIVE if buttons == 0 => {
+                event.x = event
+                    .x
+                    .clamp(-Self::MAX_RELATIVE_DELTA, Self::MAX_RELATIVE_DELTA);
+                event.y = event
+                    .y
+                    .clamp(-Self::MAX_RELATIVE_DELTA, Self::MAX_RELATIVE_DELTA);
+                if event.x == 0 && event.y == 0 {
+                    return None;
+                }
+                SemanticMouseKind::RelativeMove
+            }
+            MOUSE_TYPE_DOWN => SemanticMouseKind::ButtonDown(Self::button(buttons)?),
+            MOUSE_TYPE_UP => SemanticMouseKind::ButtonUp(Self::button(buttons)?),
+            MOUSE_TYPE_WHEEL if buttons == 0 => {
+                event.x = event
+                    .x
+                    .clamp(-Self::MAX_SCROLL_DELTA, Self::MAX_SCROLL_DELTA);
+                event.y = event
+                    .y
+                    .clamp(-Self::MAX_SCROLL_DELTA, Self::MAX_SCROLL_DELTA);
+                if event.x == 0 && event.y == 0 {
+                    return None;
+                }
+                SemanticMouseKind::DiscreteScroll
+            }
+            MOUSE_TYPE_TRACKPAD if buttons == 0 => {
+                event.x = event
+                    .x
+                    .clamp(-Self::MAX_SCROLL_DELTA, Self::MAX_SCROLL_DELTA);
+                event.y = event
+                    .y
+                    .clamp(-Self::MAX_SCROLL_DELTA, Self::MAX_SCROLL_DELTA);
+                if event.x == 0 && event.y == 0 {
+                    return None;
+                }
+                SemanticMouseKind::PreciseScroll
+            }
+            _ => return None,
+        };
+        Some(Self { event, kind })
+    }
+
+    fn button(value: i32) -> Option<SemanticMouseButton> {
+        match value {
+            MOUSE_BUTTON_LEFT => Some(SemanticMouseButton::Left),
+            MOUSE_BUTTON_RIGHT => Some(SemanticMouseButton::Right),
+            MOUSE_BUTTON_WHEEL => Some(SemanticMouseButton::Middle),
+            MOUSE_BUTTON_BACK => Some(SemanticMouseButton::Back),
+            MOUSE_BUTTON_FORWARD => Some(SemanticMouseButton::Forward),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn is_left_button_up(&self) -> bool {
+        self.kind == SemanticMouseKind::ButtonUp(SemanticMouseButton::Left)
+    }
+}
