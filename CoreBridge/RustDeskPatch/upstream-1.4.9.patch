+        let mapping = Arc::new(InputMappingEpoch::new());
+        let authorization =
+            InputAuthorization::Required(permission.snapshot().expect("input starts enabled"));
+        let first = mapping.snapshot().expect("mapping starts valid");
+        let current_gate = input_adapter_gate(
