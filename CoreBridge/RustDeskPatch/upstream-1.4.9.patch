+struct InputPermissionEpoch {
+    // Even values are disabled; odd values are enabled. Keeping both the
+    // generation and permission bit in one atomic prevents torn snapshots.
+    state: AtomicU64,
+}
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+impl InputPermissionEpoch {
+    fn new(enabled: bool) -> Self {
+        Self {
+            state: AtomicU64::new(u64::from(enabled)),
+        }
+    }
+
+    /// Returns true only when this call rotated the permission generation.
+    fn set_enabled(&self, enabled: bool) -> bool {
+        let mut current = self.state.load(Ordering::Acquire);
+        loop {
+            if current % 2 == u64::from(enabled) {
+                return false;
+            }
+            // Never wrap because an old snapshot could otherwise become valid
+            // again. Saturation is fail-closed and practically unreachable.
+            if enabled && current >= u64::MAX - 1 {
+                return false;
+            }
+            let next = current.checked_add(1).unwrap_or(u64::MAX - 1);
+            match self.state.compare_exchange_weak(
+                current,
+                next,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            ) {
+                Ok(_) => return true,
+                Err(actual) => current = actual,
+            }
+        }
+    }
