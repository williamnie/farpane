+/// Releases remote input accepted before a permission revocation or session
+/// close. Call this through the connection's ordered input queue so no earlier
+/// queued event can re-press a key or button after cleanup.
+pub fn release_remote_input_state_then<F>(conn: i32, completion: F)
+where
+    F: FnOnce() + Send + 'static,
+{
+    #[cfg(target_os = "macos")]
+    {
+        // Execute the state snapshot and releases on the same serial queue as
+        // macOS input. This prevents cleanup from observing empty state while
+        // an earlier authorized adapter task is still waiting to run.
+        QUEUE.exec_async(move || {
+            release_remote_input_state_now(conn);
+            completion();
+        });
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        release_remote_input_state_now(conn);
+        completion();
+    }
+}
+
+fn release_remote_input_state_now(conn: i32) {
+    let pressed_keys = KEYS_DOWN
+        .lock()
+        .unwrap()
+        .drain()
+        .map(|(record_key, _)| record_key)
+        .collect::<Vec<_>>();
+    for record_key in pressed_keys {
+        release_record_key_now(record_key);
+    }
+    set_relative_mouse_active(conn, false);
+    let buttons = take_remote_mouse_buttons(conn);
+    let mut en = ENIGO.lock().unwrap();
+    for raw_button in buttons {
+        if let Some(button) = remote_mouse_button(raw_button) {
+            en.mouse_up(button);
+        }
+    }
+}
