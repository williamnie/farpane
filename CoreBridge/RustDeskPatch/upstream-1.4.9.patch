+fn remote_mouse_button(button: i32) -> Option<MouseButton> {
+    match button {
+        MOUSE_BUTTON_LEFT => Some(MouseButton::Left),
+        MOUSE_BUTTON_RIGHT => Some(MouseButton::Right),
+        MOUSE_BUTTON_WHEEL => Some(MouseButton::Middle),
+        MOUSE_BUTTON_BACK => Some(MouseButton::Back),
+        MOUSE_BUTTON_FORWARD => Some(MouseButton::Forward),
+        _ => None,
+    }
+}
+
+fn record_remote_mouse_button(conn: i32, button: i32, down: bool) {
+    let mut states = REMOTE_MOUSE_BUTTONS_DOWN.lock().unwrap();
+    if down {
+        states.entry(conn).or_default().insert(button);
+        return;
+    }
+    let remove_connection = states
+        .get_mut(&conn)
+        .map(|buttons| {
+            buttons.remove(&button);
+            buttons.is_empty()
+        })
+        .unwrap_or(false);
+    if remove_connection {
+        states.remove(&conn);
+    }
+}
+
+fn take_remote_mouse_buttons(conn: i32) -> Vec<i32> {
+    REMOTE_MOUSE_BUTTONS_DOWN
+        .lock()
+        .unwrap()
+        .remove(&conn)
+        .map(|buttons| buttons.into_iter().collect())
+        .unwrap_or_default()
+}
