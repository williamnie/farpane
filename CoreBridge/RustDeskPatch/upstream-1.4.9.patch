+    #[test]
+    fn cumulative_login_failure_cooldown_is_bounded_and_resets_bucket() {
+        const FAILURE_MINUTE: i32 = 10_000;
+        const TEST_KEY: &str = "198.51.100.77";
+        let blocked = (FAILURE_MINUTE, 1, LOGIN_FAILURE_TOTAL_LIMIT + 1);
+
+        assert_eq!(
+            Connection::cumulative_failure_cooldown_remaining_minutes(
+                blocked,
+                FAILURE_MINUTE,
+                LOGIN_FAILURE_TOTAL_LIMIT,
+            ),
+            Some(LOGIN_FAILURE_TOTAL_COOLDOWN_MINUTES)
+        );
+        assert_eq!(
+            Connection::cumulative_failure_cooldown_remaining_minutes(
+                blocked,
+                FAILURE_MINUTE + LOGIN_FAILURE_TOTAL_COOLDOWN_MINUTES - 1,
+                LOGIN_FAILURE_TOTAL_LIMIT,
+            ),
+            Some(1)
+        );
+        assert_eq!(
+            Connection::normalize_failure_entry_after_cooldown(
+                blocked,
+                FAILURE_MINUTE + LOGIN_FAILURE_TOTAL_COOLDOWN_MINUTES - 1,
+                LOGIN_FAILURE_TOTAL_LIMIT,
+            ),
+            blocked
+        );
+        assert_eq!(
+            Connection::normalize_failure_entry_after_cooldown(
+                blocked,
+                FAILURE_MINUTE + LOGIN_FAILURE_TOTAL_COOLDOWN_MINUTES,
+                LOGIN_FAILURE_TOTAL_LIMIT,
+            ),
+            (0, 0, 0)
+        );
+
+        LOGIN_FAILURES[0]
+            .lock()
+            .unwrap()
+            .insert(TEST_KEY.to_owned(), blocked);
+        let reset = Connection::failure_entry_with_cooldown(
+            0,
+            TEST_KEY,
+            FAILURE_MINUTE + LOGIN_FAILURE_TOTAL_COOLDOWN_MINUTES,
+            LOGIN_FAILURE_TOTAL_LIMIT,
+        );
+        assert_eq!(reset, (0, 0, 0));
+        assert!(!LOGIN_FAILURES[0].lock().unwrap().contains_key(TEST_KEY));
+        assert_eq!(
+            Connection::bump_failure_entry(
+                reset,
+                FAILURE_MINUTE + LOGIN_FAILURE_TOTAL_COOLDOWN_MINUTES
+            ),
+            (FAILURE_MINUTE + LOGIN_FAILURE_TOTAL_COOLDOWN_MINUTES, 1, 1)
+        );
+    }
