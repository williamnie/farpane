@@ -260,2 +265,254 @@ pub fn new(source: VideoSource, idx: usize) -> GenericService {
 
+#[cfg(feature = "rdn-native-host")]
+struct NativeRouteGuard(crate::rdn_host_bridge::NativeMediaRoute);
+
+#[cfg(feature = "rdn-native-host")]
+impl Drop for NativeRouteGuard {
+    fn drop(&mut self) {
+        crate::rdn_host_bridge::native_media_end_route(&self.0);
+    }
+}
+
+#[cfg(feature = "rdn-native-host")]
+fn native_media_message(
+    packet: crate::rdn_host_bridge::NativeMediaAccessUnit,
+    negotiated_codec: CodecFormat,
+    display_idx: usize,
+) -> ResultType<Message> {
+    let expected_codec = match negotiated_codec {
+        CodecFormat::H264 => crate::rdn_host_bridge::MEDIA_CODEC_H264,
+        CodecFormat::H265 => crate::rdn_host_bridge::MEDIA_CODEC_H265,
+        _ => bail!("native host codec is not negotiated"),
+    };
+    if packet.codec != expected_codec {
+        bail!("native media packet codec does not match negotiated codec");
+    }
+    let _validated_framing = packet.framing;
+    let _validated_parameter_sets = packet.has_parameter_sets;
+    let encoded = EncodedVideoFrame {
+        data: Bytes::from(packet.data),
+        key: packet.keyframe,
+        pts: (packet.pts_us / 1_000).min(i64::MAX as u64) as i64,
+        ..Default::default()
+    };
+    let frames = EncodedVideoFrames {
+        frames: vec![encoded].into(),
+        ..Default::default()
+    };
+    let mut video_frame = VideoFrame::new();
+    match negotiated_codec {
+        CodecFormat::H264 => video_frame.set_h264s(frames),
+        CodecFormat::H265 => video_frame.set_h265s(frames),
+        _ => unreachable!(),
+    }
+    video_frame.display = display_idx as _;
+    let mut message = Message::new();
+    message.set_video_frame(video_frame);
+    Ok(message)
+}
+
+#[cfg(feature = "rdn-native-host")]
+fn run_native(vs: VideoService) -> ResultType<()> {
+    let mut _raii = Raii::new(vs.idx, vs.sp.name());
+    let display_idx = vs.idx;
+    let sp = vs.sp;
+    let display = display_service::get_display_info(display_idx)
+        .ok_or_else(|| anyhow!("native host display is unavailable"))?;
+    let codec_format = Encoder::negotiated_codec();
+    let codec = match codec_format {
+        CodecFormat::H264 => crate::rdn_host_bridge::MEDIA_CODEC_H264,
+        CodecFormat::H265 => crate::rdn_host_bridge::MEDIA_CODEC_H265,
+        _ => bail!("native host codec is not negotiated"),
+    };
+    let (spf, bitrate_kbps) = {
+        let qos = VIDEO_QOS.lock().unwrap();
+        (qos.spf(), qos.bitrate())
+    };
+    // RustDesk encoder/QoS bitrate values are kbps; the native media control
+    // contract and VideoToolbox AverageBitRate use bits per second.
+    let bitrate_bps = bitrate_kbps.saturating_mul(1_000);
+    let fps = (1.0 / spf.as_secs_f64()).round().clamp(1.0, 240.0) as u32;
+    VIDEO_QOS
+        .lock()
+        .unwrap()
+        .set_support_changing_quality(&sp.name(), false);
+    if sp.is_option_true(OPTION_REFRESH) {
+        sp.set_option_bool(OPTION_REFRESH, false);
+    }
+    let route = crate::rdn_host_bridge::native_media_begin_route(
+        display_idx as u64,
+        1,
+        codec,
+        display.width.max(0) as u32,
+        display.height.max(0) as u32,
+        fps,
+        bitrate_bps,
+    )
+    .map_err(|error| anyhow!(error))?;
+    let route = NativeRouteGuard(route);
+    let mut frame_controller = VideoFrameController::new(display_idx);
+    let (mut second_instant, mut send_counter) = (Instant::now(), 0usize);
+    let mut first_dispatch_reported = false;
+    let mut first_ack_reported = false;
+    let mut refresh_pending = false;
+
+    while sp.ok() {
+        if sp.is_option_true(OPTION_REFRESH) {
+            sp.set_option_bool(OPTION_REFRESH, false);
+            refresh_pending = true;
+            crate::rdn_host_bridge::native_media_request_idr(&route.0, "remoteRefresh");
+        }
+        if codec_format != Encoder::negotiated_codec() {
+            log::info!(
+                "switch native source due to codec changed, {:?} -> {:?}",
+                codec_format,
+                Encoder::negotiated_codec()
+            );
+            bail!("SWITCH");
+        }
+        if display_service::get_display_info(display_idx).as_ref() != Some(&display) {
+            if let Some(message) = make_display_changed_msg(display_idx, None, VideoSource::Monitor)
+            {
+                let message = Arc::new(message);
+                sp.send_shared(message.clone());
+                sp.snapshot(move |snapshot| {
+                    snapshot.send_shared(message.clone());
+                    Ok(())
+                })?;
+            }
+            bail!("SWITCH");
+        }
+        sp.snapshot(|snapshot| {
+            if snapshot.has_subscribes() {
+                crate::rdn_host_bridge::native_media_request_idr(&route.0, "newSubscriber");
+                bail!("SWITCH");
+            }
+            Ok(())
+        })?;
+
+        let packet = match route.0.receiver.recv_timeout(Duration::from_millis(100)) {
+            Ok(packet) => packet,
+            Err(std::sync::mpsc::RecvTimeoutError::Timeout) => continue,
+            Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => {
+                bail!("native media route disconnected")
+            }
+        };
+        debug_assert_eq!(packet.codec, route.0.codec);
+        let packet_metadata = packet.metadata();
+        let message = native_media_message(packet, codec_format, display_idx)?;
+        let now = Instant::now();
+        frame_controller.reset();
+        let send_conn_ids = sp.send_video_frame(message);
+        let subscriber_count = send_conn_ids.len();
+        if subscriber_count > 0 && !first_dispatch_reported {
+            crate::rdn_host_bridge::native_media_report_milestone(
+                &route.0,
+                crate::rdn_host_bridge::NativeMediaMilestone::FirstPacketDispatched,
+                packet_metadata,
+                subscriber_count,
+            );
+            first_dispatch_reported = true;
+        }
+        if subscriber_count > 0 && refresh_pending && packet_metadata.keyframe {
+            crate::rdn_host_bridge::native_media_report_milestone(
+                &route.0,
+                crate::rdn_host_bridge::NativeMediaMilestone::RefreshKeyframeDispatched,
+                packet_metadata,
+                subscriber_count,
+            );
+            refresh_pending = false;
+        }
+        frame_controller.set_send(now, send_conn_ids);
+        send_counter += 1;
+
+        let mut fetched_conn_ids = HashSet::new();
+        let wait_begin = Instant::now();
+        while wait_begin.elapsed().as_millis() < 3_000 {
+            frame_controller.try_wait_next(&mut fetched_conn_ids, 300);
+            if fetched_conn_ids.len() >= frame_controller.send_conn_ids.len() {
+                break;
+            }
+        }
+        if !first_ack_reported
+            && !frame_controller.send_conn_ids.is_empty()
+            && frame_controller.send_conn_ids.is_subset(&fetched_conn_ids)
+        {
+            crate::rdn_host_bridge::native_media_report_milestone(
+                &route.0,
+                crate::rdn_host_bridge::NativeMediaMilestone::FirstPacketAcknowledged,
+                packet_metadata,
+                frame_controller.send_conn_ids.len(),
+            );
+            first_ack_reported = true;
+        }
+        DISPLAY_CONN_IDS.lock().unwrap().remove(&display_idx);
+        if second_instant.elapsed() >= Duration::from_secs(1) {
+            VIDEO_QOS
+                .lock()
+                .unwrap()
+                .update_display_data(&sp.name(), send_counter);
+            second_instant = Instant::now();
+            send_counter = 0;
+        }
+        let elapsed = now.elapsed();
+        if elapsed < spf {
+            std::thread::sleep(spf - elapsed);
+        }
+    }
+    Ok(())
+}
+
+#[cfg(all(test, feature = "rdn-native-host"))]
+mod native_host_tests {
+    use super::*;
+
+    #[test]
+    fn native_media_message_preserves_h264_payload_metadata_and_display() {
+        let payload = vec![0, 0, 0, 2, 0x65, 0x88];
+        let message = native_media_message(
+            crate::rdn_host_bridge::NativeMediaAccessUnit {
+                codec: crate::rdn_host_bridge::MEDIA_CODEC_H264,
+                framing: 2,
+                pts_us: 42_999,
+                keyframe: true,
+                has_parameter_sets: true,
+                data: payload.clone(),
+            },
+            CodecFormat::H264,
+            3,
+        )
+        .unwrap();
+        let video_frame = match message.union {
+            Some(message::Union::VideoFrame(frame)) => frame,
+            _ => panic!("native media message must contain a video frame"),
+        };
+        assert_eq!(video_frame.display, 3);
+        let frames = match video_frame.union {
+            Some(video_frame::Union::H264s(frames)) => frames,
+            _ => panic!("negotiated H.264 must use the h264s protobuf field"),
+        };
+        assert_eq!(frames.frames.len(), 1);
+        assert_eq!(frames.frames[0].data.as_ref(), payload.as_slice());
+        assert!(frames.frames[0].key);
+        assert_eq!(frames.frames[0].pts, 42);
+    }
+
+    #[test]
+    fn native_media_message_rejects_codec_mismatch() {
+        let result = native_media_message(
+            crate::rdn_host_bridge::NativeMediaAccessUnit {
+                codec: crate::rdn_host_bridge::MEDIA_CODEC_H265,
+                framing: 2,
+                pts_us: 1,
+                keyframe: true,
+                has_parameter_sets: true,
+                data: vec![1],
+            },
+            CodecFormat::H264,
+            0,
+        );
+        assert!(result.is_err());
+    }
+}
