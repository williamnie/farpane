+    on_console: Option<bool>,
+    login_done: Option<bool>,
+    locked: Option<bool>,
+) -> bool {
+    on_console == Some(true) && login_done == Some(true) && locked == Some(false)
+}
+
+fn session_dictionary_boolean(
+    dictionary: &CFDictionary,
+    key: &str,
+    missing_value: Option<bool>,
+) -> Option<bool> {
+    let key = CFString::new(key);
+    let value = unsafe {
+        CFDictionaryGetValue(
+            dictionary.as_concrete_TypeRef(),
+            key.as_concrete_TypeRef() as _,
+        ) as CFBooleanRef
+    };
+    if value.is_null() {
+        return missing_value;
+    }
+    unsafe {
+        if value == kCFBooleanTrue {
+            Some(true)
+        } else if value == kCFBooleanFalse {
+            Some(false)
+        } else {
+            None
+        }
+    }
+}
+
+pub fn is_active_aqua_session() -> bool {
+    autoreleasepool(|| unsafe {
+        let dictionary = CGSessionCopyCurrentDictionary();
+        if dictionary.is_null() {
+            return false;
+        }
+        let dictionary = CFDictionary::wrap_under_create_rule(dictionary);
+        active_aqua_session_from_flags(
+            session_dictionary_boolean(&dictionary, "kCGSSessionOnConsoleKey", None),
+            session_dictionary_boolean(&dictionary, "kCGSessionLoginDoneKey", None),
+            // Unlike the other required flags, unlocked sessions omit this key.
+            session_dictionary_boolean(&dictionary, "CGSSessionScreenIsLocked", Some(false)),
+        )
+    })
+}
