+    /// Returns only QoS values belonging to the subscribers that received the
+    /// current display route. Users without TestDelay history remain
+    /// explicitly unsampled instead of inheriting the 150 ms control default.
+    pub(crate) fn route_network_snapshot(
+        &self,
+        connection_ids: &HashSet<i32>,
+    ) -> RouteNetworkSnapshot {
+        let mut snapshot = RouteNetworkSnapshot {
+            subscriber_count: connection_ids.len(),
+            ..Default::default()
+        };
+        for connection_id in connection_ids {
+            let Some(user) = self.users.get(connection_id) else {
+                continue;
+            };
+            snapshot.qos_subscriber_count += 1;
+            if !user.delay.delay_history.is_empty() {
+                snapshot.delay_sampled_subscribers += 1;
+                let delay = user.delay.avg_delay();
+                snapshot.worst_network_delay_ms = Some(
+                    snapshot
+                        .worst_network_delay_ms
+                        .map_or(delay, |current| current.max(delay)),
+                );
+            }
+            if let Some(rtt) = user.delay.rtt_calculator.get_rtt() {
+                snapshot.rtt_sampled_subscribers += 1;
+                snapshot.worst_rtt_ms = Some(
+                    snapshot
+                        .worst_rtt_ms
+                        .map_or(rtt, |current| current.max(rtt)),
+                );
+            }
+            if user.delay.response_delayed {
+                snapshot.response_delayed_subscribers += 1;
+            }
+        }
+        snapshot
+    }
