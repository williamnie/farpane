+    #[test]
+    fn native_host_remote_slot_check_and_reservation_is_single_winner() {
+        let slots = Arc::new(Mutex::new(Vec::<AuthConnType>::new()));
+        let barrier = Arc::new(std::sync::Barrier::new(8));
+        let contenders = (0..8)
+            .map(|_| {
+                let slots = slots.clone();
+                let barrier = barrier.clone();
+                std::thread::spawn(move || {
+                    barrier.wait();
+                    let mut slots = slots.lock().unwrap();
+                    if native_host_remote_slot_available(
+                        true,
+                        AuthConnType::Remote,
+                        slots.iter().copied(),
+                    ) {
+                        slots.push(AuthConnType::Remote);
+                        true
+                    } else {
+                        false
+                    }
+                })
+            })
+            .collect::<Vec<_>>();
+        let winners = contenders
+            .into_iter()
+            .map(|contender| contender.join().unwrap())
+            .filter(|won| *won)
+            .count();
+        assert_eq!(winners, 1);
+
+        slots.lock().unwrap().clear();
+        assert!(native_host_remote_slot_available(
+            true,
+            AuthConnType::Remote,
+            slots.lock().unwrap().iter().copied(),
+        ));
+    }
