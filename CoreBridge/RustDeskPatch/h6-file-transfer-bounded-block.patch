+fn validated_file_transfer_block_payload(block: &FileTransferBlock) -> ResultType<Cow<'_, [u8]>> {
+    if block.data.len() > MAX_FILE_TRANSFER_BLOCK_BYTES {
+        bail!(
+            "file transfer wire payload exceeds {} bytes",
+            MAX_FILE_TRANSFER_BLOCK_BYTES
+        );
+    }
+    if block.compressed {
+        let decoded =
+            decompress_with_limit(&block.data, MAX_FILE_TRANSFER_BLOCK_BYTES).map_err(|_| {
+                anyhow!(
+                    "invalid compressed payload or decoded payload exceeds {} bytes",
+                    MAX_FILE_TRANSFER_BLOCK_BYTES
+                )
+            })?;
+        Ok(Cow::Owned(decoded))
+    } else {
+        Ok(Cow::Borrowed(block.data.as_ref()))
+    }
+}
