+    fn transfer_block(data: Vec<u8>, compressed: bool) -> FileTransferBlock {
+        FileTransferBlock {
+            data: data.into(),
+            compressed,
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn bounded_file_block_accepts_raw_and_compressed_payloads_at_decoded_limit() {
+        let plain = vec![b'a'; MAX_FILE_TRANSFER_BLOCK_BYTES];
+        let raw = transfer_block(plain.clone(), false);
+        assert_eq!(
+            validated_file_transfer_block_payload(&raw)
+                .unwrap()
+                .as_ref(),
+            plain.as_slice()
+        );
+
+        let compressed = transfer_block(compress(&plain), true);
+        assert_eq!(
+            validated_file_transfer_block_payload(&compressed)
+                .unwrap()
+                .as_ref(),
+            plain.as_slice()
+        );
+    }
+
+    #[test]
+    fn bounded_file_block_rejects_raw_and_wire_payloads_over_limit() {
+        let raw = transfer_block(vec![0; MAX_FILE_TRANSFER_BLOCK_BYTES + 1], false);
+        assert_err_contains(
+            validated_file_transfer_block_payload(&raw).unwrap_err(),
+            "wire payload exceeds",
+        );
+
+        let compressed = transfer_block(vec![0; MAX_FILE_TRANSFER_BLOCK_BYTES + 1], true);
+        assert_err_contains(
+            validated_file_transfer_block_payload(&compressed).unwrap_err(),
+            "wire payload exceeds",
+        );
+    }
+
+    #[test]
+    fn bounded_file_block_rejects_decoded_oversize_and_malformed_compression() {
+        let oversized_plain = vec![b'a'; MAX_FILE_TRANSFER_BLOCK_BYTES + 1];
+        let oversized = transfer_block(compress(&oversized_plain), true);
+        assert_err_contains(
+            validated_file_transfer_block_payload(&oversized).unwrap_err(),
+            "decoded payload exceeds",
+        );
+
+        let malformed = transfer_block(vec![0x28, 0xb5, 0x2f, 0xfd, 0xff], true);
+        assert_err_contains(
+            validated_file_transfer_block_payload(&malformed).unwrap_err(),
+            "invalid compressed payload",
+        );
+    }
