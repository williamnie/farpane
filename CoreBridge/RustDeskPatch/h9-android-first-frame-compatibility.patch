 #[cfg(feature = "rdn-native-host")]
+fn native_android_compatibility_dimensions(width: u32, height: u32) -> (u32, u32) {
+    const MAX_WIDTH: u32 = 1_920;
+    const MAX_HEIGHT: u32 = 1_080;
+    const MIN_DIMENSION: u32 = 16;
+
+    let width = width.max(MIN_DIMENSION);
+    let height = height.max(MIN_DIMENSION);
+    if width <= MAX_WIDTH && height <= MAX_HEIGHT {
+        return (width & !1, height & !1);
+    }
+
+    let (scaled_width, scaled_height) =
+        if u64::from(width) * u64::from(MAX_HEIGHT) >= u64::from(height) * u64::from(MAX_WIDTH) {
+            (
+                MAX_WIDTH,
+                (u64::from(height) * u64::from(MAX_WIDTH) / u64::from(width)) as u32,
+            )
+        } else {
+            (
+                (u64::from(width) * u64::from(MAX_HEIGHT) / u64::from(height)) as u32,
+                MAX_HEIGHT,
+            )
+        };
+    (
+        (scaled_width.max(MIN_DIMENSION)) & !1,
+        (scaled_height.max(MIN_DIMENSION)) & !1,
+    )
+}
