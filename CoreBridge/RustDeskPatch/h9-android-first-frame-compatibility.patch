+        // decode failure. H.264 has the safest startup path there, while an
+        // available explicit H.265 preference remains authoritative.
+        decoding.ability_h264 = decoding.ability_h264.max(1);
+        decoding.prefer = PreferCodec::H264.into();
+    }
+    decoding
