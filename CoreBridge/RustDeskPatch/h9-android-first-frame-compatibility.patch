+    let should_prefer_h264 = match preference {
+        PreferCodec::Auto | PreferCodec::H264 => h264_available,
+        PreferCodec::H265 => decoding.ability_h265 <= 0 && h264_available,
+        _ => false,
+    };
+    if native_video_prefers_annex_b_for_platform(platform) && should_prefer_h264 {
