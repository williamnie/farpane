+fn validate_monitor_display_switch_target(
+    requested_display: i32,
+    get_display: impl FnOnce(usize) -> Option<DisplayInfo>,
+) -> Option<usize> {
+    let display_idx = usize::try_from(requested_display).ok()?;
+    let display = get_display(display_idx)?;
+    if !display.online
+        || display.width <= 0
+        || display.height <= 0
+        || !display.scale.is_finite()
+        || display.scale <= 0.0
+    {
+        return None;
+    }
+    display.x.checked_add(display.width)?;
+    display.y.checked_add(display.height)?;
+    Some(display_idx)
+}
