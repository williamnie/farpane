+    #[test]
+    fn monitor_display_switch_target_is_live_bounded_and_fail_closed() {
+        let valid = DisplayInfo {
+            x: -1920,
+            y: 0,
+            width: 1920,
+            height: 1080,
+            online: true,
+            scale: 2.0,
+            ..Default::default()
+        };
+        assert_eq!(
+            validate_monitor_display_switch_target(1, |_| Some(valid.clone())),
+            Some(1)
+        );
+        assert_eq!(
+            validate_monitor_display_switch_target(-1, |_| Some(valid.clone())),
+            None
+        );
+        assert_eq!(validate_monitor_display_switch_target(2, |_| None), None);
+
+        let invalid = [
+            DisplayInfo {
+                online: false,
+                ..valid.clone()
+            },
+            DisplayInfo {
+                width: 0,
+                ..valid.clone()
+            },
+            DisplayInfo {
+                height: -1,
+                ..valid.clone()
+            },
+            DisplayInfo {
+                scale: 0.0,
+                ..valid.clone()
+            },
+            DisplayInfo {
+                scale: f64::NAN,
+                ..valid.clone()
+            },
+            DisplayInfo {
+                x: i32::MAX,
+                ..valid.clone()
+            },
+            DisplayInfo {
+                y: i32::MAX,
+                ..valid.clone()
+            },
+        ];
+        for display in invalid {
+            assert_eq!(
+                validate_monitor_display_switch_target(1, |_| Some(display)),
+                None
+            );
+        }
+    }
