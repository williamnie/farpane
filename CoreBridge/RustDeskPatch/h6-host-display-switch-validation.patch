+        assert_eq!(
+            validate_monitor_display_switch_target(-1, |_| Some(valid.clone())),
+            None
+        );
+        assert_eq!(validate_monitor_display_switch_target(2, |_| None), None);
+
+        let invalid = [
+            DisplayInfo {
+                online: false,
