+/// Wipes caller-owned secret bytes through libsodium without requiring every
+/// embedding crate to add its own sodiumoxide dependency.
+pub fn memzero_secret(bytes: &mut [u8]) {
+    sodiumoxide::utils::memzero(bytes);
+}
