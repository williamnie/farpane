+#[cfg(feature = "farpane-native")]
+impl<T> ConnectionTmpl<T> where T: AsyncRead + AsyncWrite + Unpin + std::os::fd::AsRawFd {
+    pub(crate) fn native_same_process(&self) -> bool {
+        farpane_protocol::transport::Peer::from_fd_for_uid(self.inner.get_ref().as_raw_fd(), unsafe { libc::geteuid() }).map(|p| p.pid == std::process::id()).unwrap_or(false)
+    }
+    pub(crate) fn native_core_peer(&self) -> bool {
+        let Some(uid) = self.peer_uid() else { return false; };
+        if uid != 0 && uid != unsafe { libc::geteuid() } { return false; }
+        ["--server", "--service", "--check-hwcodec-config"].iter().any(|role| self.native_identity(uid, role).is_some())
+    }
+    fn native_identity(&self, uid: u32, role: &str) -> Option<crate::farpane_native::process::Process> {
+        let peer = farpane_protocol::transport::Peer::from_fd_for_uid(self.inner.get_ref().as_raw_fd(), uid).ok()?;
+        let exe = std::env::current_exe().and_then(std::fs::canonicalize).ok()?;
+        peer.verify_executable(&exe).ok()?;
+        let process = crate::farpane_native::process::Process::exact(peer.pid, &exe, Some(uid), role).ok()?;
+        peer.ensure_alive().ok()?;
+        Some(process)
+    }
+    pub(crate) fn native_server_identity(&self, uid: u32) -> Option<crate::farpane_native::process::Process> {
+        self.native_identity(uid, "--server")
+    }
+}
