+#[cfg(all(target_os = "linux", feature = "farpane-native"))]
+pub struct ClipboardSnapshot(Vec<ClipboardData>);
+
+#[cfg(all(target_os = "linux", feature = "farpane-native"))]
+pub fn snapshot_for_paste_restore() -> Option<ClipboardSnapshot> {
+    let mut ctx = CLIPBOARD_CTX.lock().unwrap();
+    if ctx.is_none() {
+        *ctx = ClipboardContext::new().ok();
+    }
+    let data = ctx.as_mut()?.get(ClipboardSide::Host, true).ok()?;
+    (!data.is_empty()).then(|| ClipboardSnapshot(data))
+}
+
+/// Restores only while CLIPBOARD still holds exactly the text the Host pasted,
+/// so content copied meanwhile (locally or from the peer) is never overwritten.
+/// The owner marker keeps the restored copy from being synced back to the peer.
+#[cfg(all(target_os = "linux", feature = "farpane-native"))]
+pub fn restore_after_paste(snapshot: ClipboardSnapshot, typed: &str) -> ResultType<bool> {
+    let mut ctx = CLIPBOARD_CTX.lock().unwrap();
+    let Some(ctx) = ctx.as_mut() else {
+        return Ok(false);
+    };
+    let current = ctx.get(ClipboardSide::Host, true)?;
+    if !matches!(current.as_slice(), [ClipboardData::Text(text)] if text == typed) {
+        return Ok(false);
+    }
+    ctx.set_with_owner_marker_for_linux(&append_owner_marker(snapshot.0, ClipboardSide::Host))?;
+    Ok(true)
+}
