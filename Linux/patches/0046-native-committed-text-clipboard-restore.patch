+/// Pasting committed text borrows CLIPBOARD. Snapshot the user's content when
+/// a typing run starts and put it back once input has been quiet long enough
+/// for the target to have read the last paste.
+#[cfg(all(target_os = "linux", feature = "farpane-native"))]
+mod paste_restore {
+    use crate::clipboard::{restore_after_paste, snapshot_for_paste_restore, ClipboardSnapshot};
+    use hbb_common::log;
+    use std::{
+        sync::{
+            atomic::{AtomicU64, Ordering},
+            Mutex,
+        },
+        time::Duration,
+    };
+
+    const QUIET: Duration = Duration::from_millis(1500);
+    static GENERATION: AtomicU64 = AtomicU64::new(0);
+    static SAVED: Mutex<Option<ClipboardSnapshot>> = Mutex::new(None);
+
+    pub(super) fn track(text: &str) {
+        let mut saved = SAVED.lock().unwrap();
+        if saved.is_none() {
+            *saved = snapshot_for_paste_restore();
+        }
+        if saved.is_none() {
+            return;
+        }
+        let generation = GENERATION.fetch_add(1, Ordering::Relaxed) + 1;
+        drop(saved);
+        let typed = text.to_owned();
+        let spawned = std::thread::Builder::new()
+            .name("paste-restore".into())
+            .spawn(move || {
+                std::thread::sleep(QUIET);
+                let mut saved = SAVED.lock().unwrap();
+                if GENERATION.load(Ordering::Relaxed) != generation {
+                    return;
+                }
+                let Some(snapshot) = saved.take() else {
+                    return;
+                };
+                match restore_after_paste(snapshot, &typed) {
+                    Ok(restored) => log::debug!("Native committed text: clipboard restored={restored}"),
+                    Err(error) => log::warn!("Native committed text: clipboard restore failed: {error}"),
+                }
+            });
+        if let Err(error) = spawned {
+            log::warn!("Native committed text: clipboard restore unavailable: {error}");
+        }
+    }
+}
