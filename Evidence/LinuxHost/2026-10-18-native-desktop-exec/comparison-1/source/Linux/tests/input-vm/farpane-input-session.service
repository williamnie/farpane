[Unit]
Description=Private GNOME login session
After=systemd-logind.service dbus.service
Requires=systemd-logind.service dbus.service

[Service]
User=1000
Group=1000
PAMName=farpane-input-test
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SESSION_DESKTOP=GNOME
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=1
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/python3 -B /opt/farpane-input-test/native_input_vm_desktop.py --session
TimeoutStopSec=5
KillMode=control-group
