+#[cfg(test)]
+mod output_buffer_tests {
+    use super::*;
+    use std::{ffi::c_int, ptr};
+
+    #[derive(Default)]
+    struct Render {
+        pixels: Vec<u8>,
+        destination: *mut u8,
+        available: usize,
+        direct_writes: usize,
+        linear: bool,
+        error: c_int,
+        short_error: c_int,
+    }
+
+    unsafe extern "C" fn set(
+        ctx: *mut drmtap_ctx,
+        dst: *mut std::ffi::c_void,
+        len: usize,
+    ) -> c_int {
+        let render = &mut *ctx.cast::<Render>();
+        render.destination = dst.cast();
+        render.available = len;
+        0
+    }
+
+    unsafe extern "C" fn convert(
+        ctx: *mut drmtap_ctx,
+        _: *const drmtap_dmabuf_desc,
+        frame: *mut drmtap_frame_info,
+    ) -> c_int {
+        let render = &mut *ctx.cast::<Render>();
+        if render.error != 0 {
+            return render.error;
+        }
+        let mut data = render.pixels.as_mut_ptr();
+        if !render.destination.is_null() && !render.linear {
+            if render.available < render.pixels.len() {
+                return if render.short_error != 0 {
+                    render.short_error
+                } else {
+                    -hbb_common::libc::ENOSPC
+                };
+            }
+            ptr::copy_nonoverlapping(data, render.destination, render.pixels.len());
+            data = render.destination;
+            render.direct_writes += 1;
+        }
+        *frame = std::mem::zeroed();
+        (*frame).data = data.cast();
+        (*frame).width = 2;
+        (*frame).height = (render.pixels.len() / 12) as u32;
+        (*frame).stride = 12;
+        (*frame).format = DRM_FORMAT_XRGB8888;
+        0
+    }
+
+    fn converter(render: &mut Render, supports_output: bool) -> RenderConverter {
+        unsafe extern "C" fn grab(_: *mut drmtap_ctx, _: *mut drmtap_frame_info) -> c_int {
+            -1
+        }
+        unsafe extern "C" fn release(_: *mut drmtap_ctx, _: *mut drmtap_frame_info) {}
+        unsafe extern "C" fn desc(
+            _: *mut drmtap_ctx,
+            _: *mut drmtap_dmabuf_desc,
+            _: *mut drmtap_frame_info,
+        ) -> c_int {
+            -1
+        }
+        unsafe extern "C" fn rotation(_: *mut drmtap_ctx, _: *mut u32) -> c_int {
+            -1
+        }
+        let mut lib = DrmtapLib::fake(grab, release, desc, rotation);
+        lib.convert_dmabuf = convert;
+        lib.set_output_buffer = supports_output.then_some(set);
+        RenderConverter {
+            lib: Box::leak(Box::new(lib)),
+            ctx: (render as *mut Render).cast(),
+        }
+    }
+
+    fn descriptor(height: u32) -> drmtap_dmabuf_desc {
+        drmtap_dmabuf_desc {
+            width: 2,
+            height,
+            pitches: [12, 0, 0, 0],
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn reused_buffer_receives_complete_padded_pixels_directly() {
+        let mut render = Render {
+            pixels: vec![0x31; 24],
+            ..Default::default()
+        };
+        let mut converter = converter(&mut render, true);
+        let mut output = Vec::new();
+        converter
+            .convert_into(&mut descriptor(2), -1, &mut output)
+            .unwrap();
+        assert_eq!(output, render.pixels);
+        render.pixels.fill(0x72);
+        converter
+            .convert_into(&mut descriptor(2), -1, &mut output)
+            .unwrap();
+        assert_eq!(output, render.pixels);
+        assert_eq!(render.direct_writes, 1);
+        assert!(render.destination.is_null());
+    }
+
+    #[test]
+    fn old_libraries_and_linear_frames_keep_the_copy_fallback() {
+        for (supported, linear) in [(false, false), (true, true)] {
+            let mut render = Render {
+                pixels: vec![0x84; 24],
+                linear,
+                ..Default::default()
+            };
+            let mut converter = converter(&mut render, supported);
+            let mut output = vec![0; 24];
+            converter
+                .convert_into(&mut descriptor(2), -1, &mut output)
+                .unwrap();
+            assert_eq!(output, render.pixels);
+            assert_eq!(render.direct_writes, 0);
+            assert!(render.destination.is_null());
+        }
+    }
+
+    #[test]
+    fn changed_geometry_uses_complete_frames_and_errors_release_the_buffer() {
+        let mut render = Render {
+            pixels: vec![0x95; 36],
+            // split convert 的 EGL 容量错误可能被后续 CPU 回退覆盖为 EINVAL。
+            short_error: -hbb_common::libc::EINVAL,
+            ..Default::default()
+        };
+        let mut converter = converter(&mut render, true);
+        let mut output = vec![0; 24];
+        converter
+            .convert_into(&mut descriptor(3), -1, &mut output)
+            .unwrap();
+        assert_eq!(output, render.pixels);
+        assert!(render.destination.is_null());
+        converter
+            .convert_into(&mut descriptor(3), -1, &mut output)
+            .unwrap();
+        assert_eq!(render.direct_writes, 1);
+        render.error = -hbb_common::libc::EAGAIN;
+        let err = converter
+            .convert_into(&mut descriptor(3), -1, &mut output)
+            .unwrap_err();
+        assert_eq!(err.kind(), io::ErrorKind::WouldBlock);
+        assert!(render.destination.is_null());
+        assert_eq!(output, render.pixels);
+        render.error = 0;
+        render.pixels.resize(24, 0);
+        converter
+            .convert_into(&mut descriptor(2), -1, &mut output)
+            .unwrap();
+        assert_eq!(output, render.pixels);
+        assert_eq!(output.len(), 24);
+    }
+}
