// convert 入口到本帧 1-byte ACK 完成；覆盖转换、复制、发布，不是端到端显示延迟。
// Linux x86_64: SYS_write=1, SYS_sendto=44。先等待 1 秒让所有探针完成挂载。
BEGIN { @on = 0; @seconds = 0; }
uprobe:/usr/lib/rustdesk/libdrmtap.so.0.5.8:drmtap_convert_dmabuf
/@on && pid == $1 && comm == "drm-recv"/
{
  if (@ready[tid]) { @missing_ack = count(); }
  @start[tid] = nsecs;
  @ready[tid] = 0;
  @convert_count = count();
}

uretprobe:/usr/lib/rustdesk/libdrmtap.so.0.5.8:drmtap_convert_dmabuf
/@on && pid == $1 && comm == "drm-recv"/
{
  if (retval == 0) {
    @conversion_us[tid] = (nsecs - @start[tid]) / 1000;
    @ready[tid] = 1;
  } else {
    @errors[(int32)retval] = count();
    @ready[tid] = 0;
  }
}

tracepoint:raw_syscalls:sys_enter
/@on && pid == $1 && comm == "drm-recv" && (args->id == 1 || args->id == 44) && args->args[2] == 1 && @ready[tid]/
{ @ack[tid] = 1; @fd[tid] = args->args[0]; }

tracepoint:raw_syscalls:sys_exit
/@on && pid == $1 && comm == "drm-recv" && (args->id == 1 || args->id == 44) && @ack[tid]/
{
  if (args->ret == 1) {
    printf("FRAME,%llu,%llu,%llu\n", @conversion_us[tid], (nsecs - @start[tid]) / 1000, @fd[tid]);
    @completed = count();
    @ready[tid] = 0;
  }
  @ack[tid] = 0;
}

interval:s:1 { @seconds = @seconds + 1; if (@seconds == 1) { @on = 1; } if (@seconds == 21) { @on = 0; exit(); } }
END { clear(@start); clear(@ready); clear(@conversion_us); clear(@ack); clear(@fd); clear(@on); clear(@seconds); }
